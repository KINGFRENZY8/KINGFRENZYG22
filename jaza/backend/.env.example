# Copy this file to ".env" and fill in the real values. NEVER commit ".env" to GitHub.

# Where the API listens (hosting platforms set PORT for you)
PORT=3000
# Use "development" on your computer and "production" on the live server
NODE_ENV=development

# Website address(es) allowed to call the API, separated by commas, no trailing slash.
# This PC (Live Server): http://127.0.0.1:5500,http://localhost:5500
# Live site:             https://jia.co.ke,https://www.jia.co.ke
ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://jia.co.ke,https://www.jia.co.ke

# Who receives the quote forms. While Mailgun is still the sandbox, this must be
# your own email, and that address must be an Authorized Recipient in Mailgun.
# After SPF, DKIM, and DMARC pass, change this to info@jia.co.ke.
RECIPIENT_EMAIL=your-own-email@example.com

# Mailgun SMTP (Mailgun → Sending → Domain settings → SMTP credentials).
# EU accounts use smtp.eu.mailgun.org instead of smtp.mailgun.org.
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=postmaster@sandboxXXXXXXXXXXXXXXXX.mailgun.org
EMAIL_PASS=your-mailgun-smtp-password
# Sandbox: EMAIL_FROM must be the same address as EMAIL_USER.
# After jia.co.ke is verified in Mailgun, change this to quotes@jia.co.ke.
EMAIL_FROM=postmaster@sandboxXXXXXXXXXXXXXXXX.mailgun.org

# Supabase → Project Settings → Database → Connection string → URI.
# Use the jaza_app user, not the postgres owner. URL-encode @ # % in the password.
DATABASE_URL=postgresql://jaza_app:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Optional on this PC. On the live server, set this to the Supabase CA certificate path.
# DATABASE_CA_CERT=./supabase-ca.crt

# Staff login cookie secret. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-at-least-32-random-characters
